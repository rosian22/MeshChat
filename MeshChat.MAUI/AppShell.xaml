<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MeshChat.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MeshChat.MAUI.Views"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Chat"
            ContentTemplate="{DataTemplate views:ChatPage}"
            Route="ChatPage" />

        <ShellContent
            Title="Peers"
            ContentTemplate="{DataTemplate views:PeersPage}"
            Route="PeersPage" />
    </TabBar>

</Shell>
