<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MeshChat.Core.Models;assembly=MeshChat.Core"
    x:Class="MeshChat.MAUI.Views.PeersPage"
    Title="Peers"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}">

    <Grid RowDefinitions="*" Padding="0">
        <!-- Peers CollectionView with Pull-to-Refresh -->
        <RefreshView
            Command="{Binding RefreshPeersCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                ItemsSource="{Binding Peers}"
                SelectionMode="None"
                Margin="0"
                Padding="0">
                <CollectionView.EmptyView>
                    <StackLayout
                        Spacing="16"
                        Padding="24"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                        <Label
                            Text="No Peers Found"
                            FontSize="24"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                        <Label
                            Text="Pull down to refresh and discover nearby peers"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#8E8E93, Dark=#98989D}" />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Peer">
                        <StackLayout Padding="16,12" Spacing="4">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectPeerCommand}"
                                    CommandParameter="{Binding .}" />
                            </StackLayout.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <!-- Peer Info -->
                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label
                                        Text="{Binding DisplayName}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label
                                            Text="{Binding Id, StringFormat='ID: {0}'}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light=#8E8E93, Dark=#98989D}"
                                            MaximumWidthRequest="200"
                                            LineBreakMode="TailTruncation" />
                                        <Label
                                            Text="{Binding LastSeenVia}"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}" />
                                    </StackLayout>
                                    <Label
                                        Text="{Binding LastSeen, StringFormat='Last seen: {0:g}'}"
                                        FontSize="11"
                                        TextColor="{AppThemeBinding Light=#8E8E93, Dark=#98989D}" />
                                </StackLayout>
                            </Grid>
                            <BoxView
                                HeightRequest="0.5"
                                Color="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                                Margin="0,8,0,0" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </Grid>

</ContentPage>
